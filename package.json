{
  "name": "discord-attestation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint --max-warnings 0 . && pnpm -r --parallel run lint && prettier --check 'updateReadme.ts' '*.json' && pnpm -r --parallel run prettier",
    "lint:fix": "eslint --fix . && pnpm -r --parallel run lint:fix && prettier --write 'updateReadme.ts' '*.json' && pnpm -r --parallel run prettier:fix",
    "prepare": "husky",
    "test": "pnpm -r --parallel run test",
    "test:e2e": "pnpm --filter @discord-attestation/frontend run test:e2e",
    "typecheck": "tsc --noEmit && pnpm -r --parallel run typecheck",
    "update-readme": "tsx updateReadme.ts",
    "verify:oauth-preview": "pnpm --filter @discord-attestation/functions exec tsx lib/verifyNetlifyPreview.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "husky": "9.1.7",
    "prettier": "catalog:",
    "sort-package-json": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
