{
  "name": "@discord-attestation/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css' 'e2e/**/*.ts' '*.ts' '*.json'",
    "prettier:fix": "prettier --write 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.css' 'e2e/**/*.ts' '*.ts' '*.json'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@reown/appkit": "2.0.0",
    "@reown/appkit-adapter-wagmi": "2.0.0",
