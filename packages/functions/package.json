{
  "name": "@discord-attestation/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "netlify functions:serve --functions . --port 8888",
    "lint": "eslint --config lib/eslint.config.js .",
    "lint:fix": "eslint --config lib/eslint.config.js --fix .",
    "prettier": "prettier --check 'api.ts' 'test/**/*.ts' '*.json'",
    "prettier:fix": "prettier --write 'api.ts' 'test/**/*.ts' '*.json'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@netlify/functions": "catalog:",
    "axios": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "netlify-cli": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "4.1.11"
  }
}
