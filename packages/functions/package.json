{
  "name": "@discord-attestation/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx lib/dev.ts",
    "lint": "eslint --config lib/eslint.config.js .",
    "lint:fix": "eslint --config lib/eslint.config.js --fix .",
    "prettier": "prettier --check 'api.ts' 'test/**/*.ts' 'lib/dev.ts' 'lib/oauthState.ts' 'lib/verifyNetlifyPreview.ts' 'lib/localDevServer.ts' 'lib/localOAuthState.ts' '*.json'",
    "prettier:fix": "prettier --write 'api.ts' 'test/**/*.ts' 'lib/dev.ts' 'lib/oauthState.ts' 'lib/verifyNetlifyPreview.ts' 'lib/localDevServer.ts' 'lib/localOAuthState.ts' '*.json'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@netlify/functions": "catalog:",
    "axios": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "4.1.11",
    "tsx": "4.23.15"
  }
}
